{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stockcorsa.local/schemas/car.schema.json",
  "title": "StockCorsa car item",
  "type": "object",
  "required": ["id", "type", "name", "author", "description", "version", "archiveType", "downloadUrl"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$" },
    "type": { "const": "car" },
    "name": {
      "type": "object",
      "required": ["fa", "en"],
      "properties": { "fa": { "type": "string", "minLength": 1 }, "en": { "type": "string", "minLength": 1 } }
    },
    "author": { "type": "string", "minLength": 1 },
    "description": {
      "type": "object",
      "required": ["fa", "en"],
      "properties": { "fa": { "type": "string", "minLength": 1 }, "en": { "type": "string", "minLength": 1 } }
    },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+" },
    "archiveType": { "enum": ["zip", "rar", "7z"] },
    "downloadUrl": { "type": "string", "pattern": "^https://" },
    "sha256": { "type": "string" },
    "size": { "type": "integer", "minimum": 1 },
    "status": { "enum": ["draft", "published", "hidden", "deprecated", "revoked"] },
    "tags": { "type": "array", "items": { "type": "string" } },
    "cover": { "type": "string" }
  },
  "additionalProperties": true
}

<UserControl x:Class="ACModHub.UI.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:ACModHub.UI.Converters">
  <UserControl.Resources>
    <c:BoolVisibilityConverter x:Key="BoolVisibility"/>
    <c:InverseBoolVisibilityConverter x:Key="InverseBoolVisibility"/>
    <c:NullToVisibilityConverter x:Key="NullVisibility"/>
    <c:StringEqualsParameterConverter x:Key="StringEqualsParameter"/>
    <c:DiagnosticStatusBrushConverter x:Key="DiagnosticStatusBrush"/>
  </UserControl.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Grid>
      <StackPanel>
        <TextBlock Text="{DynamicResource SettingsTitle}" Style="{StaticResource PageTitle}"/>
        <TextBlock Text="{Binding Message}" Foreground="{StaticResource SafeBrush}" Margin="0,6,0,0" TextWrapping="Wrap"
                   Visibility="{Binding HasError, Converter={StaticResource InverseBoolVisibility}}"/>
        <TextBlock Text="{Binding Message}" Foreground="{StaticResource ErrorBrush}" Margin="0,6,0,0" TextWrapping="Wrap"
                   Visibility="{Binding HasError, Converter={StaticResource BoolVisibility}}"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
        <Button Content="{DynamicResource Cancel}" Command="{Binding CancelCommand}" Margin="0,0,8,0"/>
        <Button Content="{DynamicResource Save}" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}"/>
      </StackPanel>
    </Grid>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,14,0,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Margin="0,0,14,0">
          <!-- Game -->
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="{DynamicResource SecGame}" Style="{StaticResource SectionTitle}" Margin="0,0,0,14"/>
              <TextBlock Text="{DynamicResource GamePathLabel}" Style="{StaticResource MutedText}" Margin="0,0,0,6"/>
              <TextBox Text="{Binding GamePath}" FlowDirection="LeftToRight" AutomationProperties.Name="{DynamicResource GamePathLabel}"/>
              <TextBlock Text="{DynamicResource SteamDetectedList}" Style="{StaticResource MutedText}" Margin="0,14,0,6"/>
              <ComboBox ItemsSource="{Binding DetectedInstallations}" SelectedItem="{Binding SelectedInstallation}" DisplayMemberPath="RootPath"
                        FlowDirection="LeftToRight" AutomationProperties.Name="{DynamicResource SteamDetectedList}"/>
              <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                <Button Content="{DynamicResource Browse}" Command="{Binding BrowseCommand}" Margin="0,0,8,0"/>
                <Button Content="{DynamicResource AutoDetect}" Command="{Binding DetectCommand}"/>
              </StackPanel>
              <CheckBox Content="{DynamicResource LaunchThroughSteam}" IsChecked="{Binding LaunchThroughSteam}" Margin="0,16,0,0"/>
            </StackPanel>
          </Border>

          <!-- Language -->
          <Border Style="{StaticResource Card}" Margin="0,12,0,0">
            <StackPanel>
              <TextBlock Text="{DynamicResource SecLanguage}" Style="{StaticResource SectionTitle}" Margin="0,0,0,14"/>
              <TextBlock Text="{DynamicResource LanguageLabel}" Style="{StaticResource MutedText}" Margin="0,0,0,6"/>
              <StackPanel Orientation="Horizontal">
                <RadioButton Content="{DynamicResource LanguageFa}" GroupName="Language" IsChecked="{Binding Language, Converter={StaticResource StringEqualsParameter}, ConverterParameter=fa-IR}" Command="{Binding LanguageSelectFaCommand}"/>
                <RadioButton Content="{DynamicResource LanguageEn}" GroupName="Language" Margin="24,0,0,0" IsChecked="{Binding Language, Converter={StaticResource StringEqualsParameter}, ConverterParameter=en-US}" Command="{Binding LanguageSelectEnCommand}"/>
              </StackPanel>
              <TextBlock Text="{DynamicResource ConcurrentDownloadsLabel}" Style="{StaticResource MutedText}" Margin="0,18,0,6"/>
              <TextBox Text="{Binding ConcurrentDownloads}" Width="100" HorizontalAlignment="Left" FlowDirection="LeftToRight" AutomationProperties.Name="{DynamicResource ConcurrentDownloadsLabel}"/>
            </StackPanel>
          </Border>

          <!-- Updates -->
          <Border Style="{StaticResource Card}" Margin="0,12,0,0">
            <StackPanel>
              <TextBlock Text="{DynamicResource SecUpdates}" Style="{StaticResource SectionTitle}" Margin="0,0,0,14"/>
              <TextBlock Text="{DynamicResource UpdateChannelLabel}" Style="{StaticResource MutedText}" Margin="0,0,0,6"/>
              <StackPanel Orientation="Horizontal">
                <RadioButton Content="{DynamicResource ChannelStable}" GroupName="Channel" IsChecked="{Binding UpdateChannel, Converter={StaticResource StringEqualsParameter}, ConverterParameter=stable}" Command="{Binding ChannelStableCommand}"/>
                <RadioButton Content="{DynamicResource ChannelBeta}" GroupName="Channel" Margin="24,0,0,0" IsChecked="{Binding UpdateChannel, Converter={StaticResource StringEqualsParameter}, ConverterParameter=beta}" Command="{Binding ChannelBetaCommand}"/>
              </StackPanel>
              <CheckBox Content="{DynamicResource CheckOnStartup}" IsChecked="{Binding CheckOnStartup}" Margin="0,16,0,0"/>
              <TextBlock Text="{DynamicResource CheckOnStartupHint}" Style="{StaticResource CaptionText}" Margin="0,6,0,0" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>

          <!-- Appearance -->
          <Border Style="{StaticResource Card}" Margin="0,12,0,0">
            <StackPanel>
              <TextBlock Text="{DynamicResource SecAppearance}" Style="{StaticResource SectionTitle}" Margin="0,0,0,14"/>
              <CheckBox Content="{DynamicResource ReducedMotion}" IsChecked="{Binding ReducedMotion}"/>
              <TextBlock Text="{DynamicResource ReducedMotionHint}" Style="{StaticResource CaptionText}" Margin="0,6,0,0" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
        </StackPanel>

        <StackPanel Grid.Column="1">
          <!-- Advanced -->
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="{DynamicResource SecAdvanced}" Style="{StaticResource SectionTitle}" Margin="0,0,0,14"/>
              <TextBlock Text="{DynamicResource CatalogEndpointLabel}" Style="{StaticResource MutedText}" Margin="0,0,0,6"/>
              <TextBox Text="{Binding CatalogUrl}" FlowDirection="LeftToRight" AutomationProperties.Name="{DynamicResource CatalogEndpointLabel}"/>
              <TextBlock Text="{DynamicResource CatalogEndpointHint}" Style="{StaticResource CaptionText}" Margin="0,6,0,0" TextWrapping="Wrap"/>
              <Separator Margin="0,16"/>
              <TextBlock Text="{DynamicResource EndpointsReadOnly}" Style="{StaticResource MutedText}" Margin="0,0,0,6"/>
              <TextBlock Text="{Binding OfficialEndpointsText}" Style="{StaticResource CaptionText}" FlowDirection="LeftToRight" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>

          <!-- Diagnostics -->
          <Border Style="{StaticResource Card}" Margin="0,12,0,0">
            <StackPanel>
              <TextBlock Text="{DynamicResource SecDiagnostics}" Style="{StaticResource SectionTitle}"/>
              <Button Content="{DynamicResource RunDiagnostics}" Command="{Binding DiagnoseCommand}" HorizontalAlignment="Left" Margin="0,12,0,12"/>
              <ItemsControl ItemsSource="{Binding Diagnostics}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Background="{StaticResource RaisedSurfaceBrush}" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                          <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                          <TextBlock Text="{Binding Detail}" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,4,0,0" FlowDirection="LeftToRight"
                                     Visibility="{Binding Detail, Converter={StaticResource NullVisibility}}"/>
                        </StackPanel>
                        <Border Grid.Column="1" Style="{StaticResource StatusPill}" VerticalAlignment="Top" Margin="10,0,0,0">
                          <StackPanel Orientation="Horizontal">
                            <Border Width="8" Height="8" CornerRadius="4" Background="{Binding Status, Converter={StaticResource DiagnosticStatusBrush}}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding StatusText}" Style="{StaticResource CaptionText}" Foreground="{StaticResource PrimaryTextBrush}"/>
                          </StackPanel>
                        </Border>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <!-- Existing content -->
          <Border Style="{StaticResource Card}" Margin="0,12,0,0">
            <StackPanel>
              <TextBlock Text="{DynamicResource SecContent}" Style="{StaticResource SectionTitle}"/>
              <TextBlock Text="{DynamicResource ScanExistingHint}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,14"/>
              <Button Content="{DynamicResource ScanExisting}" Command="{Binding ScanCommand}" HorizontalAlignment="Left"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </ScrollViewer>

    <TextBlock Grid.Row="2" Text="{DynamicResource SettingsBusy}" Style="{StaticResource MutedText}" Margin="0,8,0,0"
               Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}"/>
  </Grid>
</UserControl>

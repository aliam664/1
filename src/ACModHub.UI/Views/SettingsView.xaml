<UserControl x:Class="ACModHub.UI.Views.SettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock Text="{DynamicResource SettingsTitle}" Style="{StaticResource PageTitle}"/>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <StackPanel Margin="0,0,14,0">
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Assetto Corsa" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16"/><TextBlock Text="{DynamicResource GamePath}" Style="{StaticResource MutedText}" Margin="0,0,0,6"/><TextBox Text="{Binding GamePath}" FlowDirection="LeftToRight"/><ComboBox ItemsSource="{Binding DetectedInstallations}" SelectedItem="{Binding SelectedInstallation}" DisplayMemberPath="RootPath" Margin="0,10,0,0" FlowDirection="LeftToRight" ToolTip="Detected Steam installations"/><WrapPanel Margin="0,12,0,0"><Button Content="{DynamicResource Browse}" Command="{Binding BrowseCommand}" Margin="0,0,8,0"/><Button Content="{DynamicResource Detect}" Command="{Binding DetectCommand}"/></WrapPanel><CheckBox Content="Launch through Steam (App ID 244210)" IsChecked="{Binding LaunchThroughSteam}" Margin="0,15,0,0" FlowDirection="LeftToRight"/></StackPanel></Border>
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{DynamicResource ApplicationLabel}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16"/><TextBlock Text="{DynamicResource LanguageLabel}" Style="{StaticResource MutedText}" Margin="0,0,0,6"/><ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding Language}"/><TextBlock Text="{DynamicResource ConcurrentDownloadsLabel}" Style="{StaticResource MutedText}" Margin="0,15,0,6"/><TextBox Text="{Binding ConcurrentDownloads}" Width="90" HorizontalAlignment="Left"/><Button Content="{DynamicResource Save}" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" Margin="0,16,0,0" HorizontalAlignment="Left"/></StackPanel></Border>
   </StackPanel>
   <StackPanel Grid.Column="1">
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{DynamicResource Diagnostics}" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Steam · Game Path · Content Folder · Write Access · Disk Space" Foreground="{StaticResource MutedBrush}" Margin="0,7,0,14" FlowDirection="LeftToRight"/><Button Content="{DynamicResource Diagnostics}" Command="{Binding DiagnoseCommand}" HorizontalAlignment="Left"/><ItemsControl ItemsSource="{Binding Diagnostics}" Margin="0,12,0,0"><ItemsControl.ItemTemplate><DataTemplate><Border Background="{StaticResource Surface2Brush}" CornerRadius="7" Padding="12" Margin="0,0,0,7"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding Message}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding Status}" Foreground="{StaticResource AccentBrush}" Margin="10,0,0,0"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{DynamicResource ExistingInstallation}" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Detect cars, tracks, skins, apps, weather and CSP files, calculate SHA-256, create manifests and import ownership." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,7,0,14" FlowDirection="LeftToRight"/><Button Content="{DynamicResource ScanExisting}" Command="{Binding ScanCommand}" HorizontalAlignment="Left"/></StackPanel></Border>
   </StackPanel>
  </Grid></ScrollViewer>
  <TextBlock Grid.Row="2" Text="{Binding Message}" Foreground="{StaticResource WarningBrush}" Margin="4,10,0,0"/>
 </Grid>
</UserControl>

<UserControl x:Class="ACModHub.UI.Views.DashboardView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
  <Grid Margin="0,0,0,20"><TextBlock Text="{DynamicResource DashboardTitle}" Style="{StaticResource PageTitle}"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="{DynamicResource Browse}" Command="{Binding BrowseCommand}" Margin="0,0,8,0"/><Button Content="{DynamicResource LaunchGame}" Command="{Binding LaunchCommand}" Style="{StaticResource PrimaryButton}"/></StackPanel></Grid>
  <Border Style="{StaticResource Card}" Padding="24"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="ASSETTO CORSA" FontSize="12" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding GameStatus}" FontSize="26" FontWeight="SemiBold" Margin="0,7"/><TextBlock Text="{Binding GamePath}" Foreground="{StaticResource MutedBrush}" FlowDirection="LeftToRight"/></StackPanel><Border Grid.Column="1" Width="76" Height="76" Background="#262DD4BF" CornerRadius="38"><TextBlock Text="AC" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{StaticResource AccentBrush}"/></Border></Grid></Border>
  <UniformGrid Columns="4" Margin="0,8,0,0">
   <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{DynamicResource InstalledMods}" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding InstalledMods}" FontSize="32" FontWeight="Bold" Margin="0,9,0,0"/></StackPanel></Border>
   <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{DynamicResource Cars}" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding Cars}" FontSize="32" FontWeight="Bold" Margin="0,9,0,0"/></StackPanel></Border>
   <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{DynamicResource Tracks}" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding Tracks}" FontSize="32" FontWeight="Bold" Margin="0,9,0,0"/></StackPanel></Border>
   <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{DynamicResource Updates}" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding Updates}" FontSize="32" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,9,0,0"/></StackPanel></Border>
  </UniformGrid>
  <Border Style="{StaticResource Card}" Margin="0,14,12,12"><StackPanel><TextBlock Text="Drag &amp; Drop" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="ZIP · 7Z · RAR  —  Analyze → Preview → Conflict Check → Backup → Install → Verify" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" FlowDirection="LeftToRight"/></StackPanel></Border>
  <TextBlock Text="{Binding Error}" Foreground="{StaticResource PrimaryBrush}" Margin="4"/>
 </StackPanel></ScrollViewer>
</UserControl>

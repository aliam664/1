<UserControl x:Class="ACModHub.UI.Views.UpdatesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:ACModHub.UI.Converters">
  <UserControl.Resources>
    <c:BoolVisibilityConverter x:Key="BoolVisibility"/>
    <c:InverseBoolVisibilityConverter x:Key="InverseBoolVisibility"/>
    <c:UpdateReadyVisibilityConverter x:Key="UpdateReadyVisibility"/>
  </UserControl.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Grid>
      <StackPanel>
        <TextBlock Text="{DynamicResource UpdatesTitle}" Style="{StaticResource PageTitle}"/>
        <TextBlock Text="{Binding Message}" Foreground="{StaticResource WarningBrush}" Margin="0,6,0,0" TextWrapping="Wrap"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
        <Button Content="{DynamicResource ViewReleaseAction}" Command="{Binding ViewReleaseCommand}" Margin="0,0,8,0" Visibility="{Binding HasUpdate, Converter={StaticResource BoolVisibility}}"/>
        <Button Content="{DynamicResource CheckNow}" Command="{Binding CheckCommand}" Style="{StaticResource PrimaryButton}"/>
      </StackPanel>
    </Grid>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,14,0,0">
      <StackPanel>
        <!-- Version summary -->
        <Border Style="{StaticResource Card}">
          <UniformGrid Columns="3">
            <StackPanel>
              <TextBlock Text="{DynamicResource CurrentVersionLabel}" Style="{StaticResource MutedText}"/>
              <TextBlock Text="{Binding CurrentVersion, StringFormat=v{0}}" FontSize="22" FontWeight="Bold" Margin="0,8,0,0" FlowDirection="LeftToRight"/>
            </StackPanel>
            <StackPanel>
              <TextBlock Text="{DynamicResource LatestVersionLabel}" Style="{StaticResource MutedText}"/>
              <TextBlock Text="{Binding AvailableVersion, StringFormat=v{0}}" FontSize="22" FontWeight="Bold" Margin="0,8,0,0" FlowDirection="LeftToRight" Foreground="{StaticResource WarningBrush}"/>
            </StackPanel>
            <StackPanel>
              <TextBlock Text="{DynamicResource ChannelLabel}" Style="{StaticResource MutedText}"/>
              <TextBlock Text="{Binding ChannelText}" FontSize="14" FontWeight="SemiBold" Margin="0,8,0,0"/>
            </StackPanel>
          </UniformGrid>
        </Border>

        <!-- Checking / up-to-date / failed -->
        <Border Style="{StaticResource Card}" Margin="0,12,0,0" Visibility="{Binding IsChecking, Converter={StaticResource BoolVisibility}}">
          <TextBlock Text="{DynamicResource Checking}" Style="{StaticResource MutedText}"/>
        </Border>
        <Border Style="{StaticResource Card}" Margin="0,12,0,0" Visibility="{Binding IsUpToDate, Converter={StaticResource BoolVisibility}}">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <Path Style="{StaticResource StrokeIcon}" Data="{StaticResource IconCheckData}" Stroke="{StaticResource SafeBrush}" VerticalAlignment="Center"/>
              <TextBlock Text="{DynamicResource UpToDateTitle}" Style="{StaticResource SectionTitle}" Margin="10,0,0,0"/>
            </StackPanel>
            <TextBlock Text="{DynamicResource UpToDateHint}" Style="{StaticResource MutedText}" Margin="0,8,0,0"/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Margin="0,12,0,0" Visibility="{Binding CheckFailed, Converter={StaticResource BoolVisibility}}">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <Path Style="{StaticResource StrokeIcon}" Data="{StaticResource IconErrorData}" Stroke="{StaticResource ErrorBrush}" VerticalAlignment="Center"/>
              <TextBlock Text="{DynamicResource UpdateCheckFailed}" Style="{StaticResource SectionTitle}" Margin="10,0,0,0"/>
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- Available update -->
        <Border Style="{StaticResource RaisedCard}" Margin="0,12,0,0" BorderBrush="{StaticResource PrimaryBrush}" BorderThickness="1"
                Visibility="{Binding HasUpdate, Converter={StaticResource BoolVisibility}}">
          <StackPanel>
            <TextBlock Text="{Binding ReleaseTitle}" Style="{StaticResource SectionTitle}" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding ReleaseNotes}" Style="{StaticResource BodyText}" Margin="0,12,0,0" MaxHeight="260"/>
            <Grid Margin="0,14,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,32,0">
                <TextBlock Text="{DynamicResource PublishedLabel}" Style="{StaticResource MutedText}"/>
                <TextBlock Text="{Binding PublishedAtText}" Margin="0,4,0,0" FlowDirection="LeftToRight"/>
              </StackPanel>
              <StackPanel Grid.Column="1">
                <TextBlock Text="{DynamicResource DownloadSizeLabel}" Style="{StaticResource MutedText}"/>
                <TextBlock Text="{Binding DownloadSizeText}" Margin="0,4,0,0" FlowDirection="LeftToRight"/>
              </StackPanel>
            </Grid>
            <TextBlock Text="{DynamicResource UpdatePrivacyHint}" Style="{StaticResource CaptionText}" Margin="0,12,0,0"/>
          </StackPanel>
        </Border>

        <!-- Download progress -->
        <Border Style="{StaticResource Card}" Margin="0,12,0,0" Visibility="{Binding IsDownloading, Converter={StaticResource BoolVisibility}}">
          <StackPanel>
            <TextBlock Text="{Binding ProgressText}" Style="{StaticResource MutedText}"/>
            <ProgressBar Value="{Binding Progress}" Maximum="100" Margin="0,10,0,0"/>
          </StackPanel>
        </Border>

        <!-- Ready to apply -->
        <Border Style="{StaticResource Card}" Margin="0,12,0,0"
                Visibility="{Binding DownloadState, Converter={StaticResource UpdateReadyVisibility}}">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <Path Style="{StaticResource StrokeIcon}" Data="{StaticResource IconCheckData}" Stroke="{StaticResource SafeBrush}" VerticalAlignment="Center"/>
              <TextBlock Text="{DynamicResource UpdateReady}" Style="{StaticResource SectionTitle}" Margin="10,0,0,0"/>
            </StackPanel>
            <TextBlock Text="{DynamicResource UpdateReadyHint}" Style="{StaticResource MutedText}" Margin="0,8,0,0" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <!-- Footer actions -->
    <Grid Grid.Row="2" Margin="0,12,0,0">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="{DynamicResource LaterAction}" Command="{Binding LaterCommand}" Margin="0,0,8,0" Visibility="{Binding HasUpdate, Converter={StaticResource BoolVisibility}}"/>
        <Button Content="{DynamicResource ViewReleaseAction}" Command="{Binding ViewReleaseCommand}" Margin="0,0,8,0" Visibility="{Binding HasUpdate, Converter={StaticResource BoolVisibility}}"/>
        <Button Content="{DynamicResource Cancel}" Command="{Binding CancelCommand}" Margin="0,0,8,0" Visibility="{Binding IsDownloading, Converter={StaticResource BoolVisibility}}"/>
        <Button Content="{DynamicResource DownloadInstallAction}" Command="{Binding DownloadInstallCommand}" Style="{StaticResource PrimaryButton}" Visibility="{Binding HasUpdate, Converter={StaticResource BoolVisibility}}"/>
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>

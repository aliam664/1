<UserControl x:Class="ACModHub.UI.Views.UpdatesView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid><TextBlock Text="{DynamicResource NavUpdates}" Style="{StaticResource PageTitle}"/><Button Content="{DynamicResource CheckProviders}" Command="{Binding CheckCommand}" HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource PrimaryButton}"/></Grid><Border Grid.Row="1" Style="{StaticResource Card}"><StackPanel><TextBlock Text="{DynamicResource ProviderArchitecture}" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Version 1 uses direct HTTP metadata. Additional providers can implement IContentProvider without changing Core or this page." Foreground="{StaticResource MutedBrush}" Margin="0,7,0,0" TextWrapping="Wrap" FlowDirection="LeftToRight"/><TextBlock Text="{Binding Message}" Foreground="{StaticResource WarningBrush}" Margin="0,10,0,0"/></StackPanel></Border><DataGrid Grid.Row="2" ItemsSource="{Binding Releases}" Margin="0,8,0,0"><DataGrid.Columns><DataGridTextColumn Header="{DynamicResource NameLabel}" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="{DynamicResource VersionLabel}" Binding="{Binding Version}" Width="120"/><DataGridTextColumn Header="URL" Binding="{Binding DownloadUrl}" Width="2*"/></DataGrid.Columns></DataGrid></Grid>
</UserControl>

<UserControl x:Class="ACModHub.UI.Views.InstallerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:ACModHub.UI.Converters">
  <UserControl.Resources>
    <c:BytesConverter x:Key="Bytes"/>
    <c:LocalizedEnumConverter x:Key="LocalizedEnum"/>
    <c:BoolVisibilityConverter x:Key="BoolVisibility"/>
    <c:InverseBoolVisibilityConverter x:Key="InverseBoolVisibility"/>
    <c:NullToVisibilityConverter x:Key="NullVisibility"/>
  </UserControl.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel>
      <TextBlock Text="{DynamicResource InstallerTitle}" Style="{StaticResource PageTitle}"/>
      <TextBlock Text="{DynamicResource InstallerHint}" Style="{StaticResource MutedText}" Margin="0,6,0,0"/>
    </StackPanel>

    <!-- Error -->
    <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource ErrorBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,12,0,0"
            Visibility="{Binding Error, Converter={StaticResource NullVisibility}}">
      <StackPanel Orientation="Horizontal">
        <Path Style="{StaticResource StrokeIcon}" Data="{StaticResource IconErrorData}" Stroke="{StaticResource ErrorBrush}" VerticalAlignment="Top" Margin="0,2,0,0"/>
        <TextBlock Text="{Binding Error}" Margin="10,0,0,0" TextWrapping="Wrap"/>
      </StackPanel>
    </Border>

    <Grid Grid.Row="2" Margin="0,14,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="400"/>
      </Grid.ColumnDefinitions>

      <!-- Preview: files -->
      <Border Style="{StaticResource Card}" Margin="0,0,14,0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <Grid>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{DynamicResource PreviewFiles}" Style="{StaticResource SectionTitle}"/>
              <TextBlock Text="{Binding Files.Count, StringFormat=({0})}" Style="{StaticResource MutedText}" Margin="8,2,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <TextBlock Text="{Binding CategoryText}" Style="{StaticResource MutedText}" Margin="0,0,12,0"/>
              <TextBlock Text="{Binding SuggestedName}" Style="{StaticResource CardTitle}" TextTrimming="CharacterEllipsis" MaxWidth="260"/>
            </StackPanel>
          </Grid>
          <ItemsControl Grid.Row="2" ItemsSource="{Binding Files}" Margin="0,12,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,3">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding DestinationPath}" Style="{StaticResource CaptionText}" FlowDirection="LeftToRight" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Grid.Column="1" Text="{Binding Size, Converter={StaticResource Bytes}}" Style="{StaticResource CaptionText}" Margin="12,0,0,0"/>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Grid.Row="1" Text="{DynamicResource CommonLoading}" Style="{StaticResource MutedText}" Margin="0,8,0,0"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}"/>
        </Grid>
      </Border>

      <!-- Preview: conflicts + decisions -->
      <Border Grid.Column="1" Style="{StaticResource RaisedCard}">
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="{DynamicResource PreviewConflicts}" Style="{StaticResource SectionTitle}"/>
            <TextBlock Text="{Binding Conflicts.Count, StringFormat=({0})}" Style="{StaticResource MutedText}" Margin="8,2,0,0"/>
          </StackPanel>
          <ListBox ItemsSource="{Binding Conflicts}" MaxHeight="240" Margin="0,10,0,0" Background="{StaticResource SurfaceBrush}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="6,4">
                  <TextBlock Text="{Binding RelativePath}" Style="{StaticResource CaptionText}" FlowDirection="LeftToRight" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Text="{Binding Message}" Style="{StaticResource CaptionText}" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <ItemsControl ItemsSource="{Binding Warnings}" Margin="0,10,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding}" Style="{StaticResource CaptionText}" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" Margin="0,3"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <CheckBox Content="{DynamicResource AllowOverwrite}" IsChecked="{Binding AllowConflicts}" Margin="0,12,0,0"
                    Visibility="{Binding HasConflicts, Converter={StaticResource BoolVisibility}}"/>

          <StackPanel Margin="0,10,0,0" Visibility="{Binding RequiresSkinTarget, Converter={StaticResource BoolVisibility}}">
            <TextBlock Text="{DynamicResource SkinCarTarget}" Style="{StaticResource MutedText}" Margin="0,0,0,6"/>
            <TextBox Text="{Binding SkinCarId}" FlowDirection="LeftToRight" AutomationProperties.Name="{DynamicResource SkinCarTarget}"/>
            <Button Content="{DynamicResource ApplySkinTarget}" Command="{Binding InstallCommand}" Margin="0,10,0,0" HorizontalAlignment="Left"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>

    <!-- Pipeline footer -->
    <Grid Grid.Row="3" Margin="0,14,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <StackPanel>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <ProgressBar Value="{Binding Progress}" Maximum="1"/>
          <TextBlock Grid.Column="1" Text="{Binding Progress, StringFormat={}{0:P0}}" Style="{StaticResource CaptionText}" Margin="12,0,0,0" FlowDirection="LeftToRight"/>
        </Grid>
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
          <Border Style="{StaticResource StatusPill}" BorderBrush="{StaticResource SafeBrush}" BorderThickness="1">
            <TextBlock Text="{Binding Stage, Converter={StaticResource LocalizedEnum}, ConverterParameter=Stage}" Style="{StaticResource CaptionText}" Foreground="{StaticResource PrimaryTextBrush}"/>
          </Border>
          <TextBlock Text="{Binding StatusText}" Style="{StaticResource MutedText}" Margin="10,0,0,0" TextWrapping="Wrap"/>
        </StackPanel>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
        <Button Content="{DynamicResource Cancel}" Command="{Binding CancelCommand}" Margin="0,0,8,0"/>
        <Button Content="{DynamicResource InstallVerify}" Command="{Binding InstallCommand}" Style="{StaticResource PrimaryButton}"
                Visibility="{Binding RequiresSkinTarget, Converter={StaticResource InverseBoolVisibility}}"/>
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>

<UserControl x:Class="ACModHub.UI.Views.InstallerView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:ACModHub.UI.Converters">
 <UserControl.Resources><c:BytesConverter x:Key="Bytes"/><c:BoolVisibilityConverter x:Key="BoolVisibility"/></UserControl.Resources>
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock Text="{DynamicResource InstallerTitle}" Style="{StaticResource PageTitle}"/>
  <Border Grid.Row="1" Style="{StaticResource Card}" Padding="20"><StackPanel><Grid><TextBlock Text="{Binding Analysis.Plan.SuggestedName}" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="{Binding Analysis.Plan.Category}" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Right"/></Grid><TextBlock Text="{Binding StatusText}" Foreground="{StaticResource MutedBrush}" Margin="0,9"/><ProgressBar Value="{Binding Progress}" Maximum="1"/><TextBlock Text="Analyze  →  Preview  →  Conflict Check  →  Backup  →  Install  →  Verify  →  Done" Margin="0,12,0,0" FontSize="12" Foreground="{StaticResource MutedBrush}" FlowDirection="LeftToRight"/></StackPanel></Border>
  <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="{DynamicResource Files}" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12"/><DataGrid Grid.Row="1" ItemsSource="{Binding Files}"><DataGrid.Columns><DataGridTextColumn Header="Destination" Binding="{Binding DestinationPath}" Width="*"/><DataGridTextColumn Header="Size" Binding="{Binding Size, Converter={StaticResource Bytes}}" Width="90"/></DataGrid.Columns></DataGrid></Grid></Border>
   <Border Grid.Column="1" Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="{DynamicResource Conflicts}" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12"/><DataGrid Grid.Row="1" ItemsSource="{Binding Conflicts}"><DataGrid.Columns><DataGridTextColumn Header="Type" Binding="{Binding Kind}" Width="130"/><DataGridTextColumn Header="File" Binding="{Binding RelativePath}" Width="*"/></DataGrid.Columns></DataGrid><CheckBox Grid.Row="2" Content="{DynamicResource AllowOverwrite}" IsChecked="{Binding AllowConflicts}" Margin="0,14,0,0"/></Grid></Border>
  </Grid>
  <Grid Grid.Row="3"><TextBlock Text="{Binding Error}" Foreground="{StaticResource PrimaryBrush}" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="{DynamicResource Cancel}" Command="{Binding CancelCommand}" Margin="0,0,8,0"/><Button Content="{DynamicResource Install}" Command="{Binding InstallCommand}" Style="{StaticResource PrimaryButton}"/></StackPanel></Grid>
 </Grid>
</UserControl>

<UserControl x:Class="ACModHub.UI.Views.DownloadsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:ACModHub.UI.Converters">
  <UserControl.Resources>
    <c:BytesConverter x:Key="Bytes"/>
    <c:DownloadStateBrushConverter x:Key="StateBrush"/>
    <c:BoolVisibilityConverter x:Key="BoolVisibility"/>
  </UserControl.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel>
      <TextBlock Text="{DynamicResource DownloadsTitle}" Style="{StaticResource PageTitle}"/>
      <TextBlock Text="{Binding Message}" Foreground="{StaticResource SafeBrush}" Margin="0,6,0,0" TextWrapping="Wrap"/>
    </StackPanel>

    <!-- Add URL -->
    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,14,0,14">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="3*"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="1.6*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,12,0">
          <TextBlock Text="{DynamicResource UrlLabel}" Style="{StaticResource MutedText}" Margin="0,0,0,5"/>
          <TextBox Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" AutomationProperties.Name="{DynamicResource UrlLabel}"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Margin="0,0,12,0">
          <TextBlock Text="{DynamicResource FileNameLabel}" Style="{StaticResource MutedText}" Margin="0,0,0,5"/>
          <TextBox Text="{Binding FileName, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" AutomationProperties.Name="{DynamicResource FileNameLabel}"/>
        </StackPanel>
        <StackPanel Grid.Column="2" Margin="0,0,12,0">
          <TextBlock Text="{DynamicResource ShaLabel}" Style="{StaticResource MutedText}" Margin="0,0,0,5"/>
          <TextBox Text="{Binding Sha256}" FlowDirection="LeftToRight" AutomationProperties.Name="{DynamicResource ShaLabel}"/>
        </StackPanel>
        <Button Grid.Column="3" Content="{DynamicResource AddAction}" Command="{Binding AddCommand}" Style="{StaticResource PrimaryButton}" VerticalAlignment="Bottom"/>
      </Grid>
    </Border>

    <!-- Queue -->
    <Grid Grid.Row="2">
      <ListBox ItemsSource="{Binding Jobs}" SelectedItem="{Binding Selected}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.ItemContainerStyle>
          <Style TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                  <Border x:Name="Root" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10">
                    <ContentPresenter/>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                      <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource StrongBorderBrush}"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid Margin="14,12">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="{Binding Job.Request.FileName}" Style="{StaticResource CardTitle}" FlowDirection="LeftToRight" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding Job.Request.Source}" Style="{StaticResource CaptionText}" FlowDirection="LeftToRight" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" HorizontalAlignment="Left" MaxWidth="560"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <Border Style="{StaticResource StatusPill}" BorderBrush="{Binding Job.State, Converter={StaticResource StateBrush}}" BorderThickness="1">
                  <StackPanel Orientation="Horizontal">
                    <Border Width="8" Height="8" CornerRadius="4" Background="{Binding Job.State, Converter={StaticResource StateBrush}}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding StateText}" Style="{StaticResource CaptionText}" Foreground="{StaticResource PrimaryTextBrush}"/>
                  </StackPanel>
                </Border>
              </StackPanel>
              <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ProgressBar Value="{Binding Percentage}" Height="6" Visibility="{Binding Percentage, Converter={StaticResource BoolVisibility}}"/>
                <TextBlock Grid.Column="1" Margin="12,0,0,0" Style="{StaticResource CaptionText}">
                  <Run Text="{Binding Job.BytesReceived, Mode=OneWay, Converter={StaticResource Bytes}}"/>
                  <Run Text=" / "/>
                  <Run Text="{Binding Job.TotalBytes, Mode=OneWay, Converter={StaticResource Bytes}}"/>
                  <Run Text=" · "/>
                  <Run Text="{Binding SpeedText, Mode=OneWay}"/>
                  <Run Text=" · ETA "/>
                  <Run Text="{Binding EtaText, Mode=OneWay}"/>
                </TextBlock>
              </Grid>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <!-- Empty state -->
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding IsEmpty, Converter={StaticResource BoolVisibility}}">
        <Path Data="{StaticResource IconDownloadData}" Width="40" Height="40" Stretch="Uniform" Fill="{StaticResource SubtleTextBrush}" HorizontalAlignment="Center"/>
        <TextBlock Text="{DynamicResource DownloadsEmptyTitle}" Style="{StaticResource SectionTitle}" HorizontalAlignment="Center" Margin="0,14,0,0"/>
        <TextBlock Text="{DynamicResource DownloadsEmptyHint}" Style="{StaticResource MutedText}" HorizontalAlignment="Center" Margin="0,8,0,0" TextWrapping="Wrap" MaxWidth="420" TextAlignment="Center"/>
      </StackPanel>
    </Grid>

    <!-- Actions -->
    <Grid Grid.Row="3" Margin="0,12,0,0">
      <TextBlock Text="{Binding Message}" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="{DynamicResource InstallPackage}" Command="{Binding InstallCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/>
        <Button Content="{DynamicResource PauseAction}" Command="{Binding PauseCommand}" Margin="0,0,8,0"/>
        <Button Content="{DynamicResource ResumeAction}" Command="{Binding ResumeCommand}" Margin="0,0,8,0"/>
        <Button Content="{DynamicResource RetryAction}" Command="{Binding RetryCommand}" Margin="0,0,8,0"/>
        <Button Content="{DynamicResource Cancel}" Command="{Binding CancelCommand}" Margin="0,0,8,0"/>
        <Button Content="{DynamicResource ClearCompleted}" Command="{Binding ClearCompletedCommand}"/>
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>

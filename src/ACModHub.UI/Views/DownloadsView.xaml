<UserControl x:Class="ACModHub.UI.Views.DownloadsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:ACModHub.UI.Converters">
 <UserControl.Resources><c:BytesConverter x:Key="Bytes"/></UserControl.Resources>
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock Text="{DynamicResource DownloadsTitle}" Style="{StaticResource PageTitle}"/>
  <Border Grid.Row="1" Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="HTTP / HTTPS URL" Style="{StaticResource MutedText}" Margin="0,0,0,5"/><TextBox Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight"/></StackPanel><StackPanel Grid.Column="1" Margin="10,0,0,0"><TextBlock Text="File name" Style="{StaticResource MutedText}" Margin="0,0,0,5"/><TextBox Text="{Binding FileName, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight"/></StackPanel><StackPanel Grid.Column="2" Margin="10,0,0,0"><TextBlock Text="SHA-256 (optional)" Style="{StaticResource MutedText}" Margin="0,0,0,5"/><TextBox Text="{Binding Sha256}" FlowDirection="LeftToRight"/></StackPanel><Button Grid.Column="3" Content="Add" Command="{Binding AddCommand}" Style="{StaticResource PrimaryButton}" Margin="12,20,0,0"/></Grid></Border>
  <DataGrid Grid.Row="2" ItemsSource="{Binding Jobs}" SelectedItem="{Binding Selected}" Margin="0,8,0,12"><DataGrid.Columns><DataGridTextColumn Header="File" Binding="{Binding Request.FileName}" Width="2*"/><DataGridTextColumn Header="State" Binding="{Binding State}" Width="120"/><DataGridTextColumn Header="Received" Binding="{Binding BytesReceived, Converter={StaticResource Bytes}}" Width="120"/><DataGridTextColumn Header="Total" Binding="{Binding TotalBytes, Converter={StaticResource Bytes}}" Width="120"/><DataGridTextColumn Header="Retries" Binding="{Binding RetryCount}" Width="80"/><DataGridTextColumn Header="Error" Binding="{Binding Error}" Width="2*"/></DataGrid.Columns></DataGrid>
  <Grid Grid.Row="3"><TextBlock Text="{Binding Message}" Foreground="{StaticResource WarningBrush}"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Pause" Command="{Binding PauseCommand}" Margin="0,0,7,0"/><Button Content="Resume" Command="{Binding ResumeCommand}" Margin="0,0,7,0"/><Button Content="Retry" Command="{Binding RetryCommand}" Margin="0,0,7,0"/><Button Content="Cancel" Command="{Binding CancelCommand}" Background="{StaticResource PrimaryBrush}"/></StackPanel></Grid>
 </Grid>
</UserControl>

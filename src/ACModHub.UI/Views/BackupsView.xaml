<UserControl x:Class="ACModHub.UI.Views.BackupsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:ACModHub.UI.Converters">
  <UserControl.Resources>
    <c:BoolVisibilityConverter x:Key="BoolVisibility"/>
  </UserControl.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Grid>
      <StackPanel>
        <TextBlock Text="{DynamicResource BackupsTitle}" Style="{StaticResource PageTitle}"/>
        <TextBlock Text="{Binding Message}" Foreground="{StaticResource SafeBrush}" Margin="0,6,0,0" TextWrapping="Wrap"/>
      </StackPanel>
      <Button Content="{DynamicResource Refresh}" Command="{Binding RefreshCommand}" HorizontalAlignment="Right" VerticalAlignment="Top"/>
    </Grid>

    <Grid Grid.Row="1" Margin="0,14,0,0">
      <ListBox ItemsSource="{Binding Backups}" SelectedItem="{Binding Selected}">
        <ListBox.ItemContainerStyle>
          <Style TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                  <Border x:Name="Root" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10">
                    <ContentPresenter/>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                      <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                      <Setter TargetName="Root" Property="BorderThickness" Value="2"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid Margin="14,12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <Border Width="44" Height="44" CornerRadius="8" Background="{StaticResource RaisedSurfaceBrush}">
                <Path Data="{StaticResource IconBackupData}" Width="22" Height="22" Stretch="Uniform" Fill="{StaticResource SafeBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding ModId}" Style="{StaticResource CardTitle}" FlowDirection="LeftToRight"/>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                  <TextBlock Text="{Binding RelativeFiles.Count, StringFormat={}{0}}" Style="{StaticResource CaptionText}"/>
                  <TextBlock Text="{DynamicResource FilesLabel}" Style="{StaticResource CaptionText}" Margin="4,0,0,0"/>
                  <TextBlock Text=" · " Style="{StaticResource CaptionText}" FlowDirection="LeftToRight"/>
                  <TextBlock Text="{Binding CreatedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" Style="{StaticResource CaptionText}" FlowDirection="LeftToRight"/>
                </StackPanel>
              </StackPanel>
              <TextBlock Grid.Column="2" Text="{Binding RootPath}" Style="{StaticResource CaptionText}" FlowDirection="LeftToRight" TextTrimming="CharacterEllipsis" MaxWidth="340" VerticalAlignment="Center"/>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding IsEmpty, Converter={StaticResource BoolVisibility}}">
        <Path Data="{StaticResource IconBackupData}" Width="40" Height="40" Stretch="Uniform" Fill="{StaticResource SubtleTextBrush}" HorizontalAlignment="Center"/>
        <TextBlock Text="{DynamicResource BackupsEmptyTitle}" Style="{StaticResource SectionTitle}" HorizontalAlignment="Center" Margin="0,14,0,0"/>
        <TextBlock Text="{DynamicResource BackupsEmptyHint}" Style="{StaticResource MutedText}" HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="420" TextAlignment="Center" Margin="0,8,0,0"/>
      </StackPanel>
    </Grid>

    <Grid Grid.Row="2" Margin="0,12,0,0">
      <TextBlock Text="{DynamicResource CommonLoading}" Style="{StaticResource MutedText}" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="{DynamicResource RestoreAction}" Command="{Binding RestoreCommand}" Margin="0,0,8,0"/>
        <Button Content="{DynamicResource DeleteAction}" Command="{Binding DeleteCommand}" Style="{StaticResource DangerButton}"/>
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>

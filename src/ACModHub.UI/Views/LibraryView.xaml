<UserControl x:Class="ACModHub.UI.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:ACModHub.UI.Converters">
  <UserControl.Resources>
    <c:BytesConverter x:Key="Bytes"/>
    <c:ModStatusBrushConverter x:Key="ModStatusBrush"/>
    <c:LocalizedEnumConverter x:Key="LocalizedEnum"/>
    <c:InverseBoolVisibilityConverter x:Key="InverseBoolVisibility"/>
    <c:InverseNullToVisibilityConverter x:Key="InverseNullVisibility"/>
    <c:BoolVisibilityConverter x:Key="BoolVisibility"/>
  </UserControl.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- Header + filters -->
    <Grid>
      <StackPanel>
        <TextBlock Text="{DynamicResource LibraryTitle}" Style="{StaticResource PageTitle}"/>
        <TextBlock Text="{Binding Message}" Foreground="{StaticResource SafeBrush}" Margin="0,6,0,0" TextWrapping="Wrap"/>
      </StackPanel>
      <Button Content="{DynamicResource Refresh}" Command="{Binding RefreshCommand}" HorizontalAlignment="Right" VerticalAlignment="Top"/>
    </Grid>
    <Grid Grid.Row="1" Margin="0,14,0,14">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="2*"/>
        <ColumnDefinition Width="170"/>
        <ColumnDefinition Width="170"/>
        <ColumnDefinition Width="170"/>
      </Grid.ColumnDefinitions>
      <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
               AutomationProperties.Name="{DynamicResource LibrarySearchPlaceholder}">
        <TextBox.ToolTip>
          <TextBlock Text="{DynamicResource LibrarySearchPlaceholder}"/>
        </TextBox.ToolTip>
      </TextBox>
      <ComboBox Grid.Column="1" Margin="10,0,0,0" ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}"
                AutomationProperties.Name="{DynamicResource CategoryLabel}">
        <ComboBox.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding Converter={StaticResource LocalizedEnum}, ConverterParameter=Category}"/>
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <ComboBox Grid.Column="2" Margin="10,0,0,0" ItemsSource="{Binding Statuses}" SelectedItem="{Binding Status}"
                AutomationProperties.Name="{DynamicResource StatusLabel}">
        <ComboBox.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding Converter={StaticResource LocalizedEnum}, ConverterParameter=Status}"/>
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <ComboBox Grid.Column="3" Margin="10,0,0,0" ItemsSource="{Binding SortModes}" SelectedItem="{Binding Sort}"
                AutomationProperties.Name="{DynamicResource SortByName}">
        <ComboBox.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding Converter={StaticResource LocalizedEnum}, ConverterParameter=SortBy}"/>
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
    </Grid>

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="360"/>
      </Grid.ColumnDefinitions>

      <!-- Mod list (virtualized) -->
      <Grid>
        <ListBox ItemsSource="{Binding Mods}" SelectedItem="{Binding SelectedMod}"
                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                 ScrollViewer.CanContentScroll="True" Margin="0,0,14,0">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="Margin" Value="0,0,0,10"/>
              <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Root" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10">
                      <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource StrongBorderBrush}"/>
                      </Trigger>
                      <Trigger Property="IsSelected" Value="True">
                        <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                        <Setter TargetName="Root" Property="BorderThickness" Value="2"/>
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid Margin="14,12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="52" Height="52" CornerRadius="8" Background="{StaticResource RaisedSurfaceBrush}">
                  <Path Data="{StaticResource IconCarData}" Width="26" Height="26" Stretch="Uniform" Fill="{StaticResource SecondaryTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Name}" Style="{StaticResource CardTitle}"/>
                  <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Text="{Binding Author}" Style="{StaticResource CaptionText}"/>
                    <TextBlock Text=" · " Style="{StaticResource CaptionText}" FlowDirection="LeftToRight"/>
                    <TextBlock Text="{Binding Version, StringFormat=v{0}}" Style="{StaticResource CaptionText}" FlowDirection="LeftToRight"/>
                    <TextBlock Text=" · " Style="{StaticResource CaptionText}" FlowDirection="LeftToRight"/>
                    <TextBlock Text="{Binding Category, Converter={StaticResource LocalizedEnum}, ConverterParameter=Category}" Style="{StaticResource CaptionText}"/>
                  </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                  <Border Style="{StaticResource StatusPill}" BorderBrush="{Binding Status, Converter={StaticResource ModStatusBrush}}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                      <Border Width="8" Height="8" CornerRadius="4" Background="{Binding Status, Converter={StaticResource ModStatusBrush}}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                      <TextBlock Text="{Binding Status, Converter={StaticResource LocalizedEnum}, ConverterParameter=Status}" Style="{StaticResource CaptionText}" Foreground="{StaticResource PrimaryTextBrush}"/>
                    </StackPanel>
                  </Border>
                  <TextBlock Text="{Binding Size, Converter={StaticResource Bytes}}" Style="{StaticResource CaptionText}" HorizontalAlignment="Right" Margin="0,6,0,0"/>
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <!-- Empty state -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolVisibility}}">
          <Path Data="{StaticResource IconLibraryData}" Width="40" Height="40" Stretch="Uniform" Fill="{StaticResource SubtleTextBrush}" HorizontalAlignment="Center"/>
          <TextBlock Text="{DynamicResource LibraryEmptyTitle}" Style="{StaticResource SectionTitle}" HorizontalAlignment="Center" Margin="0,14,0,0"/>
          <TextBlock Text="{DynamicResource LibraryEmptyHint}" Style="{StaticResource MutedText}" HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="420" TextAlignment="Center" Margin="0,8,0,0"/>
        </StackPanel>
      </Grid>

      <!-- Detail panel -->
      <Border Grid.Column="1" Style="{StaticResource RaisedCard}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <!-- No selection -->
          <StackPanel Grid.Row="1" Visibility="{Binding SelectedMod, Converter={StaticResource InverseNullVisibility}}"
                      VerticalAlignment="Center" HorizontalAlignment="Center">
            <Path Data="{StaticResource IconInfoData}" Style="{StaticResource StrokeIcon}" Width="30" Height="30" HorizontalAlignment="Center"/>
            <TextBlock Text="{DynamicResource LibraryNoSelection}" Style="{StaticResource MutedText}" HorizontalAlignment="Center" Margin="0,10,0,0"/>
          </StackPanel>

          <!-- Selected mod -->
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                        Visibility="{Binding SelectedMod, Converter={StaticResource NullVisibility}}">
            <StackPanel>
              <TextBlock Text="{DynamicResource LibraryDetails}" Style="{StaticResource SectionTitle}"/>
              <TextBlock Text="{Binding SelectedMod.Name}" FontSize="20" FontWeight="Bold" Margin="0,12,0,0" TextWrapping="Wrap"/>

              <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="{DynamicResource AuthorLabel}" Style="{StaticResource MutedText}" Margin="0,4"/>
                <TextBlock Grid.Column="1" Grid.Row="0" Text="{Binding SelectedMod.Author}" Margin="14,4,0,0"/>
                <TextBlock Grid.Row="1" Text="{DynamicResource VersionLabel}" Style="{StaticResource MutedText}" Margin="0,4"/>
                <TextBlock Grid.Column="1" Grid.Row="1" Text="{Binding SelectedMod.Version, StringFormat=v{0}}" Margin="14,4,0,0" FlowDirection="LeftToRight"/>
                <TextBlock Grid.Row="2" Text="{DynamicResource CategoryLabel}" Style="{StaticResource MutedText}" Margin="0,4"/>
                <TextBlock Grid.Column="1" Grid.Row="2" Text="{Binding SelectedMod.Category, Converter={StaticResource LocalizedEnum}, ConverterParameter=Category}" Margin="14,4,0,0"/>
                <TextBlock Grid.Row="3" Text="{DynamicResource SizeLabel}" Style="{StaticResource MutedText}" Margin="0,4"/>
                <TextBlock Grid.Column="1" Grid.Row="3" Text="{Binding SelectedMod.Size, Converter={StaticResource Bytes}}" Margin="14,4,0,0"/>
                <TextBlock Grid.Row="4" Text="{DynamicResource InstalledDateLabel}" Style="{StaticResource MutedText}" Margin="0,4"/>
                <TextBlock Grid.Column="1" Grid.Row="4" Text="{Binding SelectedMod.InstalledAt, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" Margin="14,4,0,0" FlowDirection="LeftToRight"/>
                <TextBlock Grid.Row="5" Text="{DynamicResource StatusLabel}" Style="{StaticResource MutedText}" Margin="0,4"/>
                <TextBlock Grid.Column="1" Grid.Row="5" Text="{Binding SelectedMod.Status, Converter={StaticResource LocalizedEnum}, ConverterParameter=Status}" Margin="14,4,0,0"/>
              </Grid>

              <!-- Verify result -->
              <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="12,10" Margin="0,14,0,0"
                      Visibility="{Binding VerificationText, Converter={StaticResource NullVisibility}}">
                <StackPanel>
                  <TextBlock Text="{Binding VerificationText}" Style="{StaticResource MutedText}" TextWrapping="Wrap"/>
                  <ItemsControl ItemsSource="{Binding VerificationIssues}" Margin="0,8,0,0">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Margin="0,2" Style="{StaticResource CaptionText}" TextWrapping="Wrap">
                          <Run Text="{Binding RelativePath, Mode=OneWay}"/><Run Text=" — "/><Run Text="{Binding Reason, Mode=OneWay}"/>
                        </TextBlock>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>

              <!-- Uninstall decision -->
              <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource WarningBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,14,0,0"
                      Visibility="{Binding ShowUninstallDecision, Converter={StaticResource BoolVisibility}}">
                <StackPanel>
                  <TextBlock Text="{DynamicResource UninstallTitle}" Style="{StaticResource CardTitle}"/>
                  <TextBlock Text="{Binding UninstallDecisionText}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                  <ItemsControl ItemsSource="{Binding UninstallAnalysis.ModifiedFiles}" Margin="0,8,0,0"
                                Visibility="{Binding RequiresUninstallDecision, Converter={StaticResource BoolVisibility}}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding RelativePath}" Style="{StaticResource CaptionText}" Margin="0,2" FlowDirection="LeftToRight" TextTrimming="CharacterEllipsis"/>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="{DynamicResource PreserveAndUninstall}" Command="{Binding PreserveAndUninstallCommand}" Margin="0,0,8,0"/>
                    <Button Content="{DynamicResource RestoreAndUninstall}" Command="{Binding RestoreAndUninstallCommand}" Margin="0,0,8,0"/>
                    <Button Content="{DynamicResource AbortUninstall}" Command="{Binding AbortUninstallCommand}"/>
                  </StackPanel>
                </StackPanel>
              </Border>

              <!-- Files -->
              <TextBlock Text="{DynamicResource FilesLabel}" Style="{StaticResource MutedText}" Margin="0,16,0,6"/>
              <ListBox ItemsSource="{Binding SelectedModFiles}" MaxHeight="220" Background="{StaticResource SurfaceBrush}">
                <ListBox.ItemContainerStyle>
                  <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="10,5"/>
                  </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding}" Style="{StaticResource CaptionText}" FlowDirection="LeftToRight" TextTrimming="CharacterEllipsis"/>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </StackPanel>
          </ScrollViewer>

          <!-- Actions -->
          <StackPanel Grid.Row="2" Margin="0,14,0,0">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
              <Button Content="{DynamicResource VerifyAction}" Command="{Binding VerifyCommand}" Margin="0,0,8,0"/>
              <Button Content="{DynamicResource EnableAction}" Command="{Binding EnableCommand}" Margin="0,0,8,0"/>
              <Button Content="{DynamicResource DisableAction}" Command="{Binding DisableCommand}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
              <Button Content="{DynamicResource RepairAction}" Command="{Binding RepairCommand}" Margin="0,0,8,0"/>
              <Button Content="{DynamicResource ReinstallAction}" Command="{Binding ReinstallCommand}" Margin="0,0,8,0"/>
              <Button Content="{DynamicResource UpdateAction}" Command="{Binding UpdateCommand}"/>
            </StackPanel>
            <Button Content="{DynamicResource UninstallAction}" Command="{Binding UninstallCommand}" Style="{StaticResource DangerButton}" HorizontalAlignment="Right"/>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>

<UserControl x:Class="ACModHub.UI.Views.LibraryView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:ACModHub.UI.Converters">
 <UserControl.Resources><c:BytesConverter x:Key="Bytes"/><c:StatusBrushConverter x:Key="StatusBrush"/></UserControl.Resources>
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid><TextBlock Text="{DynamicResource LibraryTitle}" Style="{StaticResource PageTitle}"/><Button Content="{DynamicResource Refresh}" Command="{Binding RefreshCommand}" HorizontalAlignment="Right" VerticalAlignment="Top"/></Grid>
  <Grid Grid.Row="1" Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="190"/><ColumnDefinition Width="190"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions>
   <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" ToolTip="{DynamicResource Search}"/>
   <ComboBox Grid.Column="1" Margin="10,0,0,0" ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}"/>
   <ComboBox Grid.Column="2" Margin="10,0,0,0" ItemsSource="{Binding Statuses}" SelectedItem="{Binding Status}"/>
   <ComboBox Grid.Column="3" Margin="10,0,0,0" ItemsSource="{Binding SortModes}" SelectedItem="{Binding Sort}"/>
  </Grid>
  <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="330"/></Grid.ColumnDefinitions>
   <ListBox ItemsSource="{Binding Mods}" SelectedItem="{Binding SelectedMod}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
    <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Width" Value="270"/><Setter Property="Margin" Value="0,0,12,12"/><Setter Property="Padding" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Template><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Card" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" SnapsToDevicePixels="True"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource AccentBrush}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/><Setter TargetName="Card" Property="BorderThickness" Value="2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Template></Style></ListBox.ItemContainerStyle>
    <ListBox.ItemTemplate><DataTemplate><Grid Height="240"><Grid.RowDefinitions><RowDefinition Height="112"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Border CornerRadius="11,11,0,0"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#26374F"/><GradientStop Color="#101620" Offset="1"/></LinearGradientBrush></Border.Background><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="AC" FontSize="30" FontWeight="Black" Foreground="#5539D2B4"/><TextBlock Text="{Binding Category}" Foreground="{StaticResource MutedBrush}"/></StackPanel></Border>
      <Grid Grid.Row="1" Margin="15,12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="16" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Row="1" Text="{Binding Author}" Foreground="{StaticResource MutedBrush}" Margin="0,4"/><StackPanel Grid.Row="3" Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="{Binding Status, Converter={StaticResource StatusBrush}}" Margin="0,0,6,0"/><TextBlock Text="{Binding Status}" FontSize="12" Foreground="{Binding Status, Converter={StaticResource StatusBrush}}"/><TextBlock Text="  ·  "/><TextBlock Text="{Binding Size, Converter={StaticResource Bytes}}" Foreground="{StaticResource MutedBrush}" FontSize="12"/><TextBlock Text="  ·  v" Foreground="{StaticResource MutedBrush}" FontSize="12"/><TextBlock Text="{Binding Version}" Foreground="{StaticResource MutedBrush}" FontSize="12"/></StackPanel></Grid>
    </Grid></DataTemplate></ListBox.ItemTemplate>
   </ListBox>
   <Border Grid.Column="1" Margin="8,0,0,12" DataContext="{Binding SelectedMod}"><Border.Style><Style TargetType="Border" BasedOn="{StaticResource Card}"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><Trigger Property="DataContext" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></Border.Style>
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="{Binding Name}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Author}" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,18"/><TextBlock Text="{DynamicResource VersionLabel}" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding Version}" Margin="0,4,0,12"/><TextBlock Text="{DynamicResource CategoryLabel}" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding Category}" Margin="0,4,0,12"/><TextBlock Text="{DynamicResource StatusLabel}" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding Status}" Foreground="{Binding Status, Converter={StaticResource StatusBrush}}" Margin="0,4,0,12"/><TextBlock Text="{DynamicResource Files}" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding Files.Count}" Margin="0,4,0,8"/><ListBox ItemsSource="{Binding Files}" MaxHeight="145" Margin="0,0,0,16"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding RelativePath}" FontSize="11" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" FlowDirection="LeftToRight"/></DataTemplate></ListBox.ItemTemplate></ListBox>
     <WrapPanel><Button Content="{DynamicResource VerifyAction}" Command="{Binding DataContext.VerifyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" Margin="0,0,6,6"/><Button Content="{DynamicResource RepairAction}" Command="{Binding DataContext.RepairCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" Margin="0,0,6,6"/><Button Content="{DynamicResource ReinstallAction}" Command="{Binding DataContext.ReinstallCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" Margin="0,0,6,6"/><Button Content="{DynamicResource UpdateAction}" Command="{Binding DataContext.UpdateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" Margin="0,0,6,6"/><Button Content="{DynamicResource EnableAction}" Command="{Binding DataContext.EnableCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" Margin="0,0,6,6"/><Button Content="{DynamicResource DisableAction}" Command="{Binding DataContext.DisableCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" Margin="0,0,6,6"/><Button Content="{DynamicResource UninstallAction}" Command="{Binding DataContext.UninstallCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" Background="{StaticResource PrimaryBrush}" Margin="0,0,6,6"/><Button Content="{DynamicResource PreserveUninstallAction}" Command="{Binding DataContext.PreserveAndUninstallCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" Margin="0,0,6,6"/><Button Content="{DynamicResource RestoreUninstallAction}" Command="{Binding DataContext.RestoreAndUninstallCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" Margin="0,0,6,6"/></WrapPanel>
    </StackPanel></ScrollViewer>
   </Border>
  </Grid>
  <TextBlock Grid.Row="3" Text="{Binding Message}" Foreground="{StaticResource WarningBrush}" Margin="4,8"/>
 </Grid>
</UserControl>

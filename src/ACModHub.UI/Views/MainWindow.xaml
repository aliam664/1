<Window x:Class="ACModHub.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:syswin="clr-namespace:System.Windows;assembly=PresentationFramework"
        xmlns:vm="clr-namespace:ACModHub.UI.ViewModels"
        xmlns:views="clr-namespace:ACModHub.UI.Views"
        xmlns:b="clr-namespace:ACModHub.UI.Behaviors"
        Title="{DynamicResource AppName}"
        Width="1440" Height="900" MinWidth="1100" MinHeight="700"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource BackgroundBrush}"
        FlowDirection="{Binding FlowDirection}"
        b:FileDropBehavior.Command="{Binding ImportCommand}">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="48" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <DataTemplate DataType="{x:Type vm:DashboardViewModel}"><views:DashboardView/></DataTemplate>
    <DataTemplate DataType="{x:Type vm:CatalogViewModel}"><views:CatalogView/></DataTemplate>
    <DataTemplate DataType="{x:Type vm:LibraryViewModel}"><views:LibraryView/></DataTemplate>
    <DataTemplate DataType="{x:Type vm:InstallerViewModel}"><views:InstallerView/></DataTemplate>
    <DataTemplate DataType="{x:Type vm:DownloadsViewModel}"><views:DownloadsView/></DataTemplate>
    <DataTemplate DataType="{x:Type vm:BackupsViewModel}"><views:BackupsView/></DataTemplate>
    <DataTemplate DataType="{x:Type vm:UpdatesViewModel}"><views:UpdatesView/></DataTemplate>
    <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><views:SettingsView/></DataTemplate>

    <!-- Navigation item template -->
    <DataTemplate x:Key="NavItemTemplate" DataType="{x:Type vm:NavigationItem}">
      <ToggleButton Style="{StaticResource NavButton}"
                    IsChecked="{Binding IsSelected, Mode=TwoWay}"
                    Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding Key}"
                    AutomationProperties.Name="{Binding LabelKey, Converter={StaticResource LocalizedKey}}">
        <StackPanel Orientation="Horizontal">
          <Path Style="{StaticResource NavIcon}" Data="{Binding IconKey, Converter={StaticResource GeometryByKey}}"/>
          <TextBlock Text="{Binding LabelKey, Converter={StaticResource LocalizedKey}}" VerticalAlignment="Center"/>
        </StackPanel>
      </ToggleButton>
    </DataTemplate>

    <!-- Window state button visibility -->
    <Style x:Key="MaximizeButton" TargetType="Button" BasedOn="{StaticResource WindowChromeButton}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=WindowState}" Value="Maximized">
          <Setter Property="Visibility" Value="Collapsed"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="RestoreButton" TargetType="Button" BasedOn="{StaticResource WindowChromeButton}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=WindowState}" Value="Normal">
          <Setter Property="Visibility" Value="Collapsed"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="48"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- ============ Title bar ============ -->
    <Border Grid.Row="0" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
      <Grid MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
          <Border Width="28" Height="28" CornerRadius="7" Background="{StaticResource PrimaryBrush}">
            <Path Data="{StaticResource IconCarData}" Width="17" Height="17" Stretch="Uniform" Fill="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <TextBlock Text="{DynamicResource AppName}" FontWeight="Bold" FontSize="14" Margin="10,0,0,0" FlowDirection="LeftToRight"/>
          <TextBlock Text="{Binding CurrentVersionText, StringFormat=v{0}}" Foreground="{StaticResource SubtleTextBrush}" FontSize="11" Margin="8,2,0,0" FlowDirection="LeftToRight"/>
        </StackPanel>
        <Button Grid.Column="2" Style="{StaticResource IconButton}" Margin="0,0,4,0"
                Command="{Binding ToggleLanguageCommand}"
                AutomationProperties.Name="{DynamicResource ToggleLanguage}"
                Content="{DynamicResource ToggleLanguage}" FontWeight="SemiBold" FontSize="12" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="44,0,0,0" shell:WindowChrome.IsHitTestVisibleInChrome="True">
          <Button Style="{StaticResource WindowChromeButton}" Command="{x:Static syswin:SystemCommands.MinimizeWindowCommand}"
                  CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" AutomationProperties.Name="{DynamicResource WinMinimize}">
            <Path Style="{StaticResource StrokeIcon}" Data="{StaticResource IconMinData}"/>
          </Button>
          <Button Style="{StaticResource MaximizeButton}" Command="{x:Static syswin:SystemCommands.MaximizeWindowCommand}"
                  CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" AutomationProperties.Name="{DynamicResource WinMaximize}">
            <Path Style="{StaticResource StrokeIcon}" Data="{StaticResource IconMaxData}"/>
          </Button>
          <Button Style="{StaticResource RestoreButton}" Command="{x:Static syswin:SystemCommands.RestoreWindowCommand}"
                  CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" AutomationProperties.Name="{DynamicResource WinRestore}">
            <Path Style="{StaticResource StrokeIcon}" Data="{StaticResource IconRestoreData}"/>
          </Button>
          <Button Style="{StaticResource CloseButton}" Command="{x:Static syswin:SystemCommands.CloseWindowCommand}"
                  CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" AutomationProperties.Name="{DynamicResource WinClose}">
            <Path Style="{StaticResource StrokeIcon}" Data="{StaticResource IconCloseData}"/>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ============ Update banner (only when an update is available) ============ -->
    <Border Grid.Row="1" Background="{StaticResource RaisedSurfaceBrush}" BorderBrush="{StaticResource PrimaryBrush}" BorderThickness="0,1,0,1"
            Visibility="{Binding UpdateBannerVisible, Converter={StaticResource BoolVisibility}}">
      <Grid Margin="28,10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal">
          <Path Style="{StaticResource StrokeIcon}" Data="{StaticResource IconUpdateData}" Stroke="{StaticResource PrimaryBrush}" VerticalAlignment="Center"/>
          <TextBlock Text="{Binding UpdateBannerText}" FontWeight="SemiBold" Margin="10,0,0,0"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button Content="{DynamicResource LaterAction}" Command="{Binding DismissUpdateCommand}" Margin="0,0,8,0"/>
          <Button Content="{DynamicResource OpenUpdates}" Command="{Binding OpenUpdatesCommand}" Style="{StaticResource PrimaryButton}"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ============ Notification area (only when a message exists) ============ -->
    <Border Grid.Row="2" Background="{StaticResource RaisedSurfaceBrush}" BorderBrush="{StaticResource WarningBrush}" BorderThickness="0,1,0,0"
            Visibility="{Binding HasNotification, Converter={StaticResource BoolVisibility}}">
      <Grid Margin="28,8">
        <StackPanel Orientation="Horizontal">
          <Path Style="{StaticResource StrokeIcon}" Data="{StaticResource IconInfoData}" Stroke="{StaticResource WarningBrush}" VerticalAlignment="Center"/>
          <TextBlock Text="{Binding Notification}" Margin="10,0,0,0" TextWrapping="Wrap"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ============ Body ============ -->
    <Grid Grid.Row="3">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="248"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- Sidebar -->
      <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding NavigationGroups}" Margin="0,14,0,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel>
                    <TextBlock Text="{Binding LabelKey, Converter={StaticResource LocalizedKey}}"
                               Foreground="{StaticResource SubtleTextBrush}" FontSize="11" FontWeight="SemiBold"
                               Margin="24,12,0,6"/>
                    <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource NavItemTemplate}"/>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <Button Grid.Row="1" Margin="14,12,14,18" Style="{StaticResource PrimaryButton}"
                  Command="{Binding ImportCommand}"
                  AutomationProperties.Name="{DynamicResource ImportMod}"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <StackPanel Orientation="Horizontal">
              <Path Style="{StaticResource StrokeIcon}" Data="{StaticResource IconDownloadData}" Stroke="#FFFFFF"/>
              <TextBlock Text="{DynamicResource ImportMod}" Margin="10,0,0,0"/>
            </StackPanel>
          </Button>
        </Grid>
      </Border>

      <!-- Content host: responsive margins, centered max width -->
      <Grid Grid.Column="1">
        <ContentControl Content="{Binding CurrentPage}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                        MaxWidth="1420" Margin="28,24"/>
      </Grid>
    </Grid>
  </Grid>
</Window>

<Window x:Class="ACModHub.UI.Views.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" xmlns:syswin="clr-namespace:System.Windows;assembly=PresentationFramework"
 xmlns:vm="clr-namespace:ACModHub.UI.ViewModels" xmlns:views="clr-namespace:ACModHub.UI.Views" xmlns:b="clr-namespace:ACModHub.UI.Behaviors"
 Title="AC Mod Hub" Width="1440" Height="900" MinWidth="1100" MinHeight="700" WindowStyle="None" ResizeMode="CanResize" FlowDirection="{Binding FlowDirection}" b:FileDropBehavior.Command="{Binding ImportCommand}">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="48" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0"/></shell:WindowChrome.WindowChrome>
 <Window.Resources>
  <DataTemplate DataType="{x:Type vm:DashboardViewModel}"><views:DashboardView/></DataTemplate><DataTemplate DataType="{x:Type vm:CatalogViewModel}"><views:CatalogView/></DataTemplate><DataTemplate DataType="{x:Type vm:LibraryViewModel}"><views:LibraryView/></DataTemplate>
  <DataTemplate DataType="{x:Type vm:InstallerViewModel}"><views:InstallerView/></DataTemplate><DataTemplate DataType="{x:Type vm:DownloadsViewModel}"><views:DownloadsView/></DataTemplate>
  <DataTemplate DataType="{x:Type vm:BackupsViewModel}"><views:BackupsView/></DataTemplate><DataTemplate DataType="{x:Type vm:UpdatesViewModel}"><views:UpdatesView/></DataTemplate>
  <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><views:SettingsView/></DataTemplate>
 </Window.Resources>
 <Grid Background="{StaticResource BackgroundBrush}">
  <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Border Grid.Row="0" Background="#0D121B" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
   <Grid Margin="16,0"><Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
     <Border Width="28" Height="28" CornerRadius="7" Background="{StaticResource PrimaryBrush}"><TextBlock Text="AC" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/></Border>
     <TextBlock Text="AC MOD HUB" FontWeight="Bold" FontSize="14" Margin="10,0,0,0" FlowDirection="LeftToRight"/>
    </StackPanel>
    <TextBlock Grid.Column="1" Text="{Binding Notification}" Foreground="{StaticResource WarningBrush}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
    <StackPanel Grid.Column="2" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
     <Button Content="FA / EN" Command="{Binding ToggleLanguageCommand}" Background="Transparent" BorderThickness="0" Padding="12,4"/>
     <Button Content="—" Command="{x:Static syswin:SystemCommands.MinimizeWindowCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" Background="Transparent" BorderThickness="0" Width="44"/>
     <Button Content="×" Command="{x:Static syswin:SystemCommands.CloseWindowCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" Background="Transparent" BorderThickness="0" Width="44" FontSize="20"/>
    </StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="238"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Grid.Column="0" Background="#0D121B" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
    <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="8,18">
      <Button Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="Catalog"><TextBlock><Run Text="✦  "/><Run Text="{DynamicResource NavCatalog}"/></TextBlock></Button>
      <Button Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="Dashboard"><TextBlock><Run Text="◈  "/><Run Text="{DynamicResource NavDashboard}"/></TextBlock></Button>
      <Button Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="Mods"><TextBlock><Run Text="▦  "/><Run Text="{DynamicResource NavMods}"/></TextBlock></Button>
      <Button Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="Cars"><TextBlock><Run Text="◆  "/><Run Text="{DynamicResource NavCars}"/></TextBlock></Button>
      <Button Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="Tracks"><TextBlock><Run Text="⌁  "/><Run Text="{DynamicResource NavTracks}"/></TextBlock></Button>
      <Button Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="Skins"><TextBlock><Run Text="◐  "/><Run Text="{DynamicResource NavSkins}"/></TextBlock></Button>
      <Button Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="Apps"><TextBlock><Run Text="⌘  "/><Run Text="{DynamicResource NavApps}"/></TextBlock></Button>
      <Border Height="1" Background="{StaticResource BorderBrush}" Margin="15,12"/>
      <Button Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="Downloads"><TextBlock><Run Text="⇩  "/><Run Text="{DynamicResource NavDownloads}"/></TextBlock></Button>
      <Button Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="Updates"><TextBlock><Run Text="↻  "/><Run Text="{DynamicResource NavUpdates}"/></TextBlock></Button>
      <Button Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="Backups"><TextBlock><Run Text="▣  "/><Run Text="{DynamicResource NavBackups}"/></TextBlock></Button>
      <Button Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="Settings"><TextBlock><Run Text="⚙  "/><Run Text="{DynamicResource NavSettings}"/></TextBlock></Button>
     </StackPanel></ScrollViewer>
     <Button Grid.Row="1" Margin="14,12,14,18" Style="{StaticResource PrimaryButton}" Command="{Binding ImportCommand}" Content="{DynamicResource ImportMod}" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
    </Grid>
   </Border>
   <Border Grid.Column="1" Padding="30,26"><ContentControl Content="{Binding CurrentPage}"/></Border>
  </Grid>
 </Grid>
</Window>

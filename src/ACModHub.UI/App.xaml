<Application x:Class="ACModHub.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:ACModHub.UI.Converters">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/ACModHub.UI;component/Resources/Theme.xaml"/>
        <ResourceDictionary Source="/ACModHub.UI;component/Resources/Icons.xaml"/>
        <ResourceDictionary Source="/ACModHub.UI;component/Resources/Strings.fa-IR.xaml"/>
      </ResourceDictionary.MergedDictionaries>

      <!-- Shared converters -->
      <c:BytesConverter x:Key="Bytes"/>
      <c:BoolVisibilityConverter x:Key="BoolVisibility"/>
      <c:InverseBoolVisibilityConverter x:Key="InverseBoolVisibility"/>
      <c:NullToVisibilityConverter x:Key="NullVisibility"/>
      <c:InverseNullToVisibilityConverter x:Key="InverseNullVisibility"/>
      <c:LocalizedEnumConverter x:Key="LocalizedEnum"/>
      <c:LocalizedKeyConverter x:Key="LocalizedKey"/>
      <c:GeometryByKeyConverter x:Key="GeometryByKey"/>
      <c:ModStatusBrushConverter x:Key="ModStatusBrush"/>
      <c:DownloadStateBrushConverter x:Key="StateBrush"/>
      <c:DiagnosticStatusBrushConverter x:Key="DiagnosticStatusBrush"/>
      <c:StringEqualsParameterConverter x:Key="StringEqualsParameter"/>
      <c:UpdateReadyVisibilityConverter x:Key="UpdateReadyVisibility"/>
    </ResourceDictionary>
  </Application.Resources>
</Application>

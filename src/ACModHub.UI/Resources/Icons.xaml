<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Single consistent vector icon set (17x17 grid, no Unicode/emoji icons anywhere). -->
  <Style x:Key="NavIcon" TargetType="Path">
    <Setter Property="Width" Value="17"/>
    <Setter Property="Height" Value="17"/>
    <Setter Property="Stretch" Value="Uniform"/>
    <Setter Property="Fill" Value="{Binding RelativeSource={RelativeSource AncestorType=ToggleButton}, Path=Foreground}"/>
    <Setter Property="Margin" Value="0,0,10,0"/>
  </Style>
  <Style x:Key="StrokeIcon" TargetType="Path">
    <Setter Property="Width" Value="17"/>
    <Setter Property="Height" Value="17"/>
    <Setter Property="Stretch" Value="Uniform"/>
    <Setter Property="Stroke" Value="{StaticResource SecondaryTextBrush}"/>
    <Setter Property="StrokeThickness" Value="1.7"/>
    <Setter Property="StrokeStartLineCap" Value="Round"/>
    <Setter Property="StrokeEndLineCap" Value="Round"/>
    <Setter Property="StrokeLineJoin" Value="Round"/>
  </Style>

